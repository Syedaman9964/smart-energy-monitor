# WattVision Backend Environment Configuration
PORT=5000
WS_PORT=5001
NODE_ENV=development
CORS_ORIGIN=*

# Device Security Key (Optional Header verification)
DEVICE_SECRET_KEY=wattvision-iot-key-2026

# Grid Safety & Anomaly Alert Thresholds
ALERT_VOLTAGE_MAX=255.0
ALERT_VOLTAGE_MIN=195.0
ALERT_CURRENT_MAX=25.0
ALERT_POWER_MAX=5000.0
ALERT_PF_MIN=0.80
ALERT_FREQ_MAX=50.8
ALERT_FREQ_MIN=49.2
