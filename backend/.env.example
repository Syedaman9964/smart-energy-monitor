# ============================================================================
# WATTVISION BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
PORT=5000
WS_PORT=5000
NODE_ENV=development

# CORS Configuration (comma-separated or single URL; DO NOT use '*' in production with credentials)
CORS_ORIGIN=http://localhost:3000

# Authentication & Session Security (Replace in production!)
JWT_SECRET=your_production_jwt_secret_key_minimum_32_chars
JWT_EXPIRES_IN=24h
COOKIE_SECRET=your_production_cookie_signing_secret_key

# Initial Seed Credentials (Change before production deployment!)
ADMIN_EMAIL=admin@wattvision.energy
ADMIN_PASSWORD=WattVision2026!Admin
ADMIN_NAME=Syed Aman

USER_EMAIL=user@wattvision.energy
USER_PASSWORD=WattVision2026!User
USER_NAME=Energy Analyst

# Device Security Key (Optional Header verification)
DEVICE_SECRET_KEY=wattvision-iot-key-2026

# Grid Safety & Anomaly Alert Thresholds
ALERT_VOLTAGE_MAX=255.0
ALERT_VOLTAGE_MIN=195.0
ALERT_CURRENT_MAX=25.0
ALERT_POWER_MAX=5000.0
ALERT_PF_MIN=0.80
ALERT_FREQ_MAX=50.8
ALERT_FREQ_MIN=49.2
