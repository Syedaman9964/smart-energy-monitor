# ============================================================================
# WATTVISION - ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# ============================================================================
# Copy this file to .env for frontend configuration, or backend/.env for backend server.

# ----------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite)
# ----------------------------------------------------------------------------
# In local development: http://localhost:5000 and ws://localhost:5000/ws
# In production with reverse proxy (Nginx, Caddy, Render single-host):
# leave blank to automatically use window.location origin and relative paths.
# In production with separate API backend domain (e.g. https://api.wattvision.io):
VITE_API_URL=
VITE_WS_URL=

# Default Indian DISCOM preset: bescom_karnataka | tangedco_tn | msedcl_mh | bses_delhi | uppcl_up
VITE_DEFAULT_TARIFF=bescom_karnataka

# ----------------------------------------------------------------------------
# BACKEND SERVER CONFIGURATION (Node.js Express + WebSocket)
# ----------------------------------------------------------------------------
PORT=5000
WS_PORT=5000
NODE_ENV=production
# In production, specify your frontend origin (e.g., https://wattvision.io or comma-separated)
CORS_ORIGIN=*

# Hardware / ESP32 Security & Access
DEVICE_SECRET_KEY=wattvision-iot-key-2026
ESP32_DEFAULT_IP=192.168.1.145

# Grid Safety & Anomaly Detection Limits (Single-Phase 230V 50Hz Standard)
ALERT_VOLTAGE_MAX=255.0
ALERT_VOLTAGE_MIN=195.0
ALERT_CURRENT_MAX=25.0
ALERT_POWER_MAX=5000.0
ALERT_PF_MIN=0.80
ALERT_FREQ_MAX=50.8
ALERT_FREQ_MIN=49.2
