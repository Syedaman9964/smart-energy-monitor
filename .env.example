# ============================================================================
# WATTVISION - ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# ============================================================================
# Copy this file to .env for frontend configuration, or backend/.env for backend server.
# NEVER commit real secrets, private keys, or production passwords to source control.

# ----------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite)
# ----------------------------------------------------------------------------
# In local development: http://localhost:5000 and ws://localhost:5000/ws
# In production with reverse proxy (Nginx, Caddy, Render single-host):
# leave blank to automatically use window.location origin and relative paths.
# In production with separate API backend domain (e.g. https://api.wattvision.io):
VITE_API_URL=
VITE_WS_URL=

# Default Indian DISCOM preset: bescom_karnataka | tangedco_tn | msedcl_mh | bses_delhi | uppcl_up
VITE_DEFAULT_TARIFF=bescom_karnataka

# ----------------------------------------------------------------------------
# BACKEND SERVER CONFIGURATION (Node.js Express + WebSocket)
# ----------------------------------------------------------------------------
PORT=5000
WS_PORT=5000
NODE_ENV=production

# CORS Configuration:
# In production, set to your specific frontend URL (e.g. https://dashboard.wattvision.energy)
# DO NOT use wildcard '*' when credentials / HTTP-only cookies are enabled.
CORS_ORIGIN=http://localhost:3000

# ----------------------------------------------------------------------------
# PRODUCTION AUTHENTICATION & CRYPTOGRAPHIC SECRETS
# ----------------------------------------------------------------------------
# CRITICAL: Generate strong random secrets (e.g. openssl rand -base64 32) before deploying to production.
JWT_SECRET=your_production_jwt_secret_key_minimum_32_chars
JWT_EXPIRES_IN=24h
COOKIE_SECRET=your_production_cookie_signing_secret_key

# Initial Administrator Seed Account (Role: ADMIN)
# IMPORTANT: Change this default password immediately upon deployment.
ADMIN_EMAIL=admin@wattvision.energy
ADMIN_PASSWORD=WattVision2026!Admin
ADMIN_NAME=Syed Aman

# Initial Analyst Seed Account (Role: USER)
USER_EMAIL=user@wattvision.energy
USER_PASSWORD=WattVision2026!User
USER_NAME=Energy Analyst

# ----------------------------------------------------------------------------
# HARDWARE / ESP32 SECURITY & ANOMALY LIMITS
# ----------------------------------------------------------------------------
DEVICE_SECRET_KEY=your_esp32_iot_shared_secret_key
ESP32_DEFAULT_IP=192.168.1.145

# Grid Safety & Anomaly Detection Limits (Single-Phase 230V 50Hz Standard)
ALERT_VOLTAGE_MAX=255.0
ALERT_VOLTAGE_MIN=195.0
ALERT_CURRENT_MAX=25.0
ALERT_POWER_MAX=5000.0
ALERT_PF_MIN=0.80
ALERT_FREQ_MAX=50.8
ALERT_FREQ_MIN=49.2
